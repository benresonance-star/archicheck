{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vic-arch-checklist.local/schema/vic-arch-checklist.schema.json",
  "title": "Victoria Architectural Checklist Package",
  "description": "Lossless package for a Victorian residential architectural project checklist. A downloadable ZIP contains manifest.json, project.json, template.json, and attachments/{id}/{filename}. Import must restore every answer, note, attachment byte, and template association.",
  "$defs": {
    "isoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "typology": {
      "type": "string",
      "enum": ["house", "townhouse", "apartment"]
    },
    "itemStatus": {
      "type": "string",
      "enum": ["todo", "in_progress", "done", "not_applicable", "blocked"]
    },
    "templateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "checksum"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "checksum": { "$ref": "#/$defs/sha256" }
      }
    },
    "answer": {
      "type": "object",
      "required": ["status", "notes", "updatedAt", "fields"],
      "properties": {
        "status": { "$ref": "#/$defs/itemStatus" },
        "notes": { "type": "string" },
        "updatedAt": { "$ref": "#/$defs/isoDateTime" },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      }
    },
    "attachment": {
      "type": "object",
      "required": [
        "id",
        "itemId",
        "filename",
        "mimeType",
        "size",
        "sha256",
        "addedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "itemId": { "type": ["string", "null"] },
        "filename": { "type": "string", "minLength": 1 },
        "mimeType": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "addedAt": { "$ref": "#/$defs/isoDateTime" }
      }
    },
    "site": {
      "type": "object",
      "required": [
        "name",
        "typology",
        "address",
        "municipality",
        "planningScheme",
        "zone",
        "overlays",
        "storeys",
        "dwellingCount",
        "lotAreaSqm",
        "notes"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "typology": { "$ref": "#/$defs/typology" },
        "address": { "type": "string" },
        "municipality": { "type": "string" },
        "planningScheme": { "type": "string" },
        "zone": { "type": "string" },
        "overlays": {
          "type": "array",
          "items": { "type": "string" }
        },
        "storeys": { "type": "integer", "minimum": 1 },
        "dwellingCount": { "type": "integer", "minimum": 1 },
        "lotAreaSqm": { "type": ["number", "null"], "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "title", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" }
      }
    },
    "checklistResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "checklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stageId",
        "title",
        "detail",
        "appliesTo",
        "required",
        "references",
        "grokbotId"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "stageId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/typology" }
        },
        "required": { "type": "boolean" },
        "references": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/checklistResource" }
        },
        "grokbotId": { "type": "string", "minLength": 1 }
      }
    },
    "grokbot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "title",
        "stageId",
        "description",
        "firstTask",
        "plugins",
        "approvalRules"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "stageId": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "firstTask": { "type": "string" },
        "plugins": {
          "type": "array",
          "items": { "type": "string" }
        },
        "approvalRules": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "projectDocument": {
      "type": "object",
      "required": [
        "format",
        "formatVersion",
        "id",
        "revision",
        "createdAt",
        "updatedAt",
        "template",
        "site",
        "answers",
        "attachments"
      ],
      "properties": {
        "format": { "const": "vic-arch-checklist-project" },
        "formatVersion": { "const": "1.0.0" },
        "id": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "createdAt": { "$ref": "#/$defs/isoDateTime" },
        "updatedAt": { "$ref": "#/$defs/isoDateTime" },
        "template": { "$ref": "#/$defs/templateRef" },
        "site": { "$ref": "#/$defs/site" },
        "answers": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/answer" }
        },
        "attachments": {
          "type": "array",
          "items": { "$ref": "#/$defs/attachment" }
        }
      }
    },
    "templateDocument": {
      "type": "object",
      "required": [
        "format",
        "formatVersion",
        "id",
        "version",
        "title",
        "jurisdiction",
        "description",
        "checksum",
        "stages",
        "items",
        "grokbots"
      ],
      "properties": {
        "format": { "const": "vic-arch-checklist-template" },
        "formatVersion": { "const": "1.0.0" },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "jurisdiction": { "type": "string" },
        "description": { "type": "string" },
        "checksum": { "$ref": "#/$defs/sha256" },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stage" }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/checklistItem" }
        },
        "grokbots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/grokbot" }
        }
      }
    },
    "packageManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "formatVersion",
        "exportedAt",
        "projectId",
        "revision",
        "templateId",
        "templateVersion",
        "templateChecksum",
        "files"
      ],
      "properties": {
        "format": { "const": "vic-arch-checklist-package" },
        "formatVersion": { "const": "1.0.0" },
        "exportedAt": { "$ref": "#/$defs/isoDateTime" },
        "projectId": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "templateId": { "type": "string", "minLength": 1 },
        "templateVersion": { "type": "string", "minLength": 1 },
        "templateChecksum": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "template", "attachments"],
          "properties": {
            "project": { "const": "project.json" },
            "template": { "const": "template.json" },
            "attachments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "path", "sha256", "size", "filename"],
                "properties": {
                  "id": { "$ref": "#/$defs/uuid" },
                  "path": {
                    "type": "string",
                    "pattern": "^attachments/[0-9a-f-]{36}/.+"
                  },
                  "sha256": { "$ref": "#/$defs/sha256" },
                  "size": { "type": "integer", "minimum": 0 },
                  "filename": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/projectDocument" },
    { "$ref": "#/$defs/templateDocument" },
    { "$ref": "#/$defs/packageManifest" }
  ]
}
